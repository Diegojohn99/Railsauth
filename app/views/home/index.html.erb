<section class="w-full max-w-3xl mx-auto rounded-2xl border border-slate-200 bg-white/90 p-8 shadow-sm">
  <h1 class="font-bold text-3xl text-slate-900">Market-Caotica Auth MVP</h1>
  <p class="mt-2 text-slate-600">Autenticacion nativa con Rails 8, registro y recuperacion de contrasena.</p>

  <% if authenticated? %>
    <div class="mt-6 rounded-lg border border-emerald-300 bg-emerald-50 p-4 text-emerald-800">
      Sesion activa: <span class="font-semibold"><%= Current.user.email_address %></span>
    </div>

    <div class="mt-6">
      <%= button_to "Cerrar sesion", session_path, method: :delete, class: "rounded-md px-4 py-2 bg-slate-900 text-white font-medium hover:bg-slate-700 cursor-pointer" %>
    </div>
  <% else %>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "Iniciar sesion", new_session_path, class: "rounded-md px-4 py-2 bg-blue-600 text-white font-medium hover:bg-blue-500" %>
      <%= link_to "Crear cuenta", new_registration_path, class: "rounded-md px-4 py-2 border border-slate-300 text-slate-700 font-medium hover:bg-slate-100" %>
    </div>
  <% end %>
</section>
</div>
