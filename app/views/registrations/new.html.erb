<section class="mx-auto w-full max-w-xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
  <% if @user&.errors&.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-700 rounded-lg">
      <p class="font-medium">No se pudo crear la cuenta:</p>
      <ul class="list-disc list-inside mt-2 text-sm">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Registro</p>
  <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Crear cuenta</h1>
  <p class="mt-2 text-sm text-slate-600">Tu contrasena se almacena encriptada usando autenticacion nativa de Rails.</p>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Correo", class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, "Contrasena", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirmar contrasena", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:outline-none" %>
    </div>

    <%= form.submit "Registrarme", class: "w-full rounded-md bg-sky-700 px-4 py-2 font-semibold text-white hover:bg-sky-600 cursor-pointer" %>
  <% end %>

  <div class="mt-5 text-sm">
    <%= link_to "Ya tengo cuenta", new_session_path, class: "font-medium text-slate-600 hover:text-slate-900" %>
  </div>
</section>
